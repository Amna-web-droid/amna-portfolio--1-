# Copy this file to .env.local and fill in your real values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# A passcode to gate the /admin page. This is a light deterrent, not real
# security (it's checked in the browser) — don't reuse a password you use
# elsewhere, and don't put anything truly private behind it.
NEXT_PUBLIC_ADMIN_PASSCODE=choose-something-only-you-know
